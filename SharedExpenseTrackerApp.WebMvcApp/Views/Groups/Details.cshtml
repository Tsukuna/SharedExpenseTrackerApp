@using SharedExpenseTrackerApp.Domain.Models.Group
@using SharedExpenseTrackerApp.Domain.Models.ExpenseList
@{
    ViewData["Title"] = ViewData["GroupName"];
    Layout = "~/Views/Shared/_Layout.cshtml";
    var group = ViewData["Group"] as GroupDetailRespModel;
    var members = ViewData["Members"] as List<GroupMemberRespModel> ?? new();
    var isCreator = (bool)(ViewData["IsCreator"] ?? false);
    long groupId = (long)(ViewData["GroupId"] ?? 0L);
    string shareCode = ViewData["ShareCode"]?.ToString() ?? "";
}

<div class="mx-auto max-w-6xl px-4 py-8">

    <!-- Back -->
    <a asp-controller="Groups" asp-action="Index"
       class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-brand-600 transition-colors mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        My Groups
    </a>

    <!-- Header -->
    <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">@group?.Name</h1>
            <div class="mt-2 flex items-center gap-2 flex-wrap">
                <span class="text-xs text-slate-500">Share code:</span>
                <span id="share-code-value" class="font-mono text-sm bg-slate-100 rounded-lg px-3 py-1 text-slate-700 select-all cursor-pointer"
                      title="Click to copy" onclick="copyShareCode()">@shareCode</span>
                <span id="copy-msg" class="text-xs text-emerald-600 hidden">Copied!</span>
            </div>
        </div>
        <a asp-controller="Lists" asp-action="Create" asp-route-groupId="@groupId"
           class="inline-flex items-center gap-2 rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-700 transition-colors shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            New List
        </a>
    </div>

    <div class="grid gap-6 lg:grid-cols-3">

        <!-- Lists column -->
        <div class="lg:col-span-2">
            <h2 class="text-base font-semibold text-slate-800 mb-4">Expense Lists</h2>
            <div id="lists-container" class="space-y-3">
                <div class="flex items-center gap-2 text-sm text-slate-400">
                    <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                    </svg>
                    Loading lists…
                </div>
            </div>
        </div>

        <!-- Members sidebar -->
        <div>
            <h2 class="text-base font-semibold text-slate-800 mb-4">
                Members
                <span class="ml-1.5 rounded-full bg-brand-100 px-2 py-0.5 text-xs text-brand-700">@members.Count</span>
            </h2>
            <div class="rounded-2xl bg-white border border-slate-200 shadow-sm divide-y divide-slate-100">
                @if (!members.Any())
                {
                    <div class="py-8 text-center text-sm text-slate-400">No members yet.</div>
                }
                @foreach (var m in members)
                {
                    <div class="flex items-center gap-3 px-4 py-3">
                        <div class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-700 text-sm font-bold">
                            @m.FullName.Substring(0,1).ToUpper()
                        </div>
                        <div class="min-w-0">
                            <p class="text-sm font-medium text-slate-800 truncate">@m.FullName</p>
                            <p class="text-xs text-slate-400">@m.PhoneNumber</p>
                        </div>
                        @if (group != null && m.UserId == group.CreatedUserId)
                        {
                            <span class="ml-auto rounded-full bg-brand-100 px-2 py-0.5 text-xs font-semibold text-brand-700">Owner</span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
    // Copy share code
    function copyShareCode() {
        navigator.clipboard.writeText('@shareCode').then(() => {
            const msg = document.getElementById('copy-msg');
            msg.classList.remove('hidden');
            setTimeout(() => msg.classList.add('hidden'), 2000);
        });
    }

    // Load lists via Axios
    (async function loadLists() {
        const container = document.getElementById('lists-container');
        try {
            const res = await api.getGroupLists(@groupId);
            const lists = res.data;
            if (!lists || lists.length === 0) {
                container.innerHTML = `
                  <div class="flex flex-col items-center justify-center rounded-2xl border-2 border-dashed border-slate-200 bg-white py-12 text-center">
                    <p class="text-sm text-slate-400 mb-3">No lists yet. Create your first one!</p>
                    <a href="/Lists/Create/@groupId?isFirst=true"
                       class="rounded-xl bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700 transition-colors">
                      Create first list
                    </a>
                  </div>`;
                return;
            }
            container.innerHTML = lists.map(l => `
              <a href="/Lists/Details/${l.id}"
                 class="flex items-center gap-4 rounded-2xl bg-white border border-slate-200 px-5 py-4 shadow-sm hover:shadow-md hover:border-brand-200 transition-all group">
                <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl ${l.isDefault ? 'bg-amber-50 text-amber-600' : 'bg-brand-50 text-brand-600'}">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                  </svg>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-semibold text-slate-800 group-hover:text-brand-600 transition-colors truncate">${l.name}</p>
                  <p class="text-xs text-slate-400">${l.isDefault ? 'Primary list' : 'Custom list'} &bull; ${new Date(l.createdAt).toLocaleDateString()}</p>
                </div>
                ${l.isDefault ? '<span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-700">Default</span>' : ''}
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-brand-300 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </a>`).join('');
        } catch (e) {
            container.innerHTML = '<p class="text-sm text-red-500">Failed to load lists.</p>';
        }
    })();
</script>
}
