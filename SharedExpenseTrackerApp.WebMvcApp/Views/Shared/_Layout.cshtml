<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — SplitWise" : "SplitWise")</title>
    <meta name="description" content="Shared Expense Tracker — track and split expenses with your family or roommates in real time." />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: {
                        brand: {
                            50:  '#eef2ff',
                            100: '#e0e7ff',
                            200: '#c7d2fe',
                            400: '#818cf8',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            800: '#3730a3',
                            900: '#312e81',
                        }
                    }
                }
            }
        }
    </script>

    <!-- Custom styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="h-full bg-slate-50 font-sans text-slate-800 antialiased">

    <!-- ── Navigation ───────────────────────────────────────────────────── -->
    @await Html.PartialAsync("_Nav")

    <!-- ── Toast Container ──────────────────────────────────────────────── -->
    <div id="toast-container" class="fixed top-20 right-4 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- ── Page Content ─────────────────────────────────────────────────── -->
    <main class="min-h-[calc(100vh-4rem)] pb-16">
        @RenderBody()
    </main>

    <!-- ── Footer ───────────────────────────────────────────────────────── -->
    <footer class="border-t border-slate-200 bg-white py-4 text-center text-sm text-slate-400">
        &copy; @DateTime.Now.Year SplitWise &mdash; Shared Expense Tracker
    </footer>

    <!-- ── Scripts ──────────────────────────────────────────────────────── -->
    <!-- Axios CDN -->
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <!-- SignalR (libman installed) -->
    <script src="~/js/signalr/dist/browser/signalr.min.js"></script>
    <!-- App JS -->
    <script src="~/js/api.js" asp-append-version="true"></script>
    <script src="~/js/signalr-client.js" asp-append-version="true"></script>

    @await RenderSectionAsync("scripts", required: false)
</body>
</html>
