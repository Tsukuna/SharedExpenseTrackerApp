@{
    var fullName = Context.Session.GetString("FullName");
    var isAuth   = !string.IsNullOrEmpty(Context.Session.GetString("UserId"));
}

<nav class="sticky top-0 z-40 h-16 bg-white/80 backdrop-blur border-b border-slate-200 shadow-sm">
    <div class="mx-auto max-w-6xl px-4 h-full flex items-center justify-between">

        <!-- Logo -->
        <a asp-controller="Groups" asp-action="Index"
           class="flex items-center gap-2 text-brand-600 font-bold text-xl tracking-tight hover:text-brand-700 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            SplitWise
        </a>

        @if (isAuth)
        {
            <div class="flex items-center gap-3">
                <!-- Live unpaid badge -->
                <span id="global-unpaid-badge"
                      class="hidden items-center gap-1 rounded-full bg-red-100 px-3 py-1 text-xs font-semibold text-red-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span id="global-unpaid-count">0</span> unpaid
                </span>

                <!-- User pill -->
                <span class="hidden sm:inline-flex items-center gap-2 rounded-full bg-brand-50 px-3 py-1.5 text-sm font-medium text-brand-700">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5.121 17.804A9 9 0 0112 15a9 9 0 016.879 2.804M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    @fullName
                </span>

                <!-- Logout -->
                <form asp-controller="Auth" asp-action="Logout" method="post" class="inline">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-50 hover:text-slate-800 transition-colors">
                        Sign out
                    </button>
                </form>
            </div>
        }
        else
        {
            <div class="flex items-center gap-2">
                <a asp-controller="Auth" asp-action="Login"
                   class="rounded-lg px-4 py-2 text-sm font-medium text-slate-600 hover:text-brand-600 transition-colors">
                    Sign in
                </a>
                <a asp-controller="Auth" asp-action="Register"
                   class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700 transition-colors shadow-sm">
                    Get started
                </a>
            </div>
        }
    </div>
</nav>
