@using SharedExpenseTrackerApp.Domain.Models.Expense
@{
    ViewData["Title"] = "Unpaid Summary";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var unpaidExpenses = ViewData["UnpaidExpenses"] as List<ExpenseRespModel> ?? new();
    long listId = (long)(ViewData["ListId"] ?? 0L);
    long groupId = (long)(ViewData["GroupId"] ?? 0L);
    int unpaidCount = (int)(ViewData["UnpaidCount"] ?? 0);
    int unpaidAmount = (int)(ViewData["UnpaidAmount"] ?? 0);
    int paidCount = (int)(ViewData["PaidCount"] ?? 0);
    int paidAmount = (int)(ViewData["PaidAmount"] ?? 0);
    int totalAmount = (int)(ViewData["TotalAmount"] ?? 0);
}

<div class="mx-auto max-w-5xl px-4 py-8">

    <!-- Back -->
    <a href="/Lists/Details/@listId"
       class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-brand-600 transition-colors mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Back to @ViewData["ListName"]
    </a>

    <h1 class="text-2xl font-bold text-slate-900 mb-8">Expense Summary — <span class="text-brand-600">@ViewData["ListName"]</span></h1>

    <!-- Stat cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
        <div class="rounded-2xl bg-white border border-slate-200 shadow-sm p-5">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1">Unpaid</p>
            <p class="text-3xl font-bold text-red-500">@unpaidAmount.ToString("N0") <span class="text-lg">ks</span></p>
            <p class="mt-1 text-sm text-slate-500">@unpaidCount item(s)</p>
        </div>
        <div class="rounded-2xl bg-white border border-slate-200 shadow-sm p-5">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1">Paid</p>
            <p class="text-3xl font-bold text-emerald-500">@paidAmount.ToString("N0") <span class="text-lg">ks</span></p>
            <p class="mt-1 text-sm text-slate-500">@paidCount item(s)</p>
        </div>
        <div class="rounded-2xl bg-white border border-slate-200 shadow-sm p-5">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1">Total</p>
            <p class="text-3xl font-bold text-slate-700">@totalAmount.ToString("N0") <span class="text-lg">ks</span></p>
            <p class="mt-1 text-sm text-slate-500">@(unpaidCount + paidCount) item(s)</p>
        </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-2">
        <!-- Chart -->
        <div class="rounded-2xl bg-white border border-slate-200 shadow-sm p-6">
            <h2 class="text-base font-semibold text-slate-800 mb-4">Paid vs Unpaid (Amount)</h2>
            <div id="expense-chart"></div>
        </div>

        <!-- Unpaid List -->
        <div class="rounded-2xl bg-white border border-slate-200 shadow-sm overflow-hidden">
            <div class="px-5 py-4 border-b border-slate-100">
                <h2 class="text-base font-semibold text-slate-800">Unpaid Expenses</h2>
            </div>
            @if (!unpaidExpenses.Any())
            {
                <div class="flex flex-col items-center justify-center py-12 text-center px-4">
                    <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-50">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <p class="text-sm font-semibold text-slate-700">All caught up!</p>
                    <p class="text-sm text-slate-400">No unpaid expenses in this list.</p>
                </div>
            }
            else
            {
                <ul class="divide-y divide-slate-100">
                    @foreach (var e in unpaidExpenses)
                    {
                        <li class="flex items-center justify-between px-5 py-3.5">
                            <div>
                                <p class="text-sm font-medium text-slate-800">@e.Name</p>
                                @if (!string.IsNullOrEmpty(e.Note))
                                {
                                    <p class="text-xs text-slate-400">@e.Note</p>
                                }
                            </div>
                            <span class="text-sm font-bold text-red-500">@e.Amount.ToString("N0") ks</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>

@section scripts {
<!-- ApexCharts CDN -->
<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
<script src="~/js/charts.js" asp-append-version="true"></script>
<script>
    initExpenseChart('expense-chart', @paidAmount, @unpaidAmount);
</script>
}
