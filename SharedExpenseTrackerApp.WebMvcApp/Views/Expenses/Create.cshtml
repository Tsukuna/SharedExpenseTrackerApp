@using SharedExpenseTrackerApp.Domain.Models.Expense
@{
    ViewData["Title"] = "Add Expense";
    Layout = "~/Views/Shared/_Layout.cshtml";
    long listId = (long)(ViewData["ListId"] ?? 0L);
    long groupId = (long)(ViewData["GroupId"] ?? 0L);
}

<div class="mx-auto max-w-lg px-4 py-12">
    <a href="/Lists/Details/@listId"
       class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-brand-600 transition-colors mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Back to @ViewData["ListName"]
    </a>

    <div class="rounded-2xl bg-white border border-slate-200 shadow-xl shadow-slate-200/60 overflow-hidden">
        <div class="h-1.5 bg-gradient-to-r from-brand-500 via-brand-400 to-indigo-400"></div>
        <div class="px-8 py-8">
            <div class="mb-7">
                <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                </div>
                <h1 class="text-2xl font-bold text-slate-900">Add Expense</h1>
                <p class="mt-1 text-sm text-slate-500">Adding to: <strong>@ViewData["ListName"]</strong></p>
            </div>

            <div id="exp-error" class="hidden mb-5 rounded-xl bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700"></div>

            <div class="space-y-5">
                <div>
                    <label for="exp-name" class="block text-sm font-medium text-slate-700 mb-1.5">Name</label>
                    <input id="exp-name" type="text" required autofocus placeholder="e.g. Electricity bill"
                           class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400
                                  focus:border-brand-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-200 transition-all" />
                </div>
                <div>
                    <label for="exp-amount" class="block text-sm font-medium text-slate-700 mb-1.5">Amount (ks)</label>
                    <input id="exp-amount" type="number" min="1" required placeholder="e.g. 50000"
                           class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400
                                  focus:border-brand-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-200 transition-all" />
                </div>
                <div>
                    <label for="exp-note" class="block text-sm font-medium text-slate-700 mb-1.5">Note <span class="text-slate-400">(optional)</span></label>
                    <input id="exp-note" type="text" placeholder="Any detail"
                           class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400
                                  focus:border-brand-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-200 transition-all" />
                </div>
                <button id="add-btn"
                        class="w-full rounded-xl bg-brand-600 py-2.5 text-sm font-semibold text-white shadow-sm
                               hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2
                               disabled:opacity-60 disabled:cursor-not-allowed transition-all">
                    Add expense
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
    document.getElementById('add-btn').addEventListener('click', async function () {
        const name   = document.getElementById('exp-name').value.trim();
        const amount = parseInt(document.getElementById('exp-amount').value, 10);
        const note   = document.getElementById('exp-note').value.trim() || null;
        const errBox = document.getElementById('exp-error');
        const btn    = this;

        if (!name)           { errBox.textContent = 'Name is required.'; errBox.classList.remove('hidden'); return; }
        if (!amount || amount < 1) { errBox.textContent = 'Enter a valid amount.'; errBox.classList.remove('hidden'); return; }

        btn.disabled = true; btn.textContent = 'Adding…';
        errBox.classList.add('hidden');

        try {
            await api.createExpense(@listId, @groupId, name, amount, note);
            window.location.href = '/Lists/Details/@listId';
        } catch(e) {
            errBox.textContent = e.response?.data?.message ?? 'Failed to add expense.';
            errBox.classList.remove('hidden');
            btn.disabled = false; btn.textContent = 'Add expense';
        }
    });
</script>
}
